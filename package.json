{
	"name": "design-system",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "designmd lint DESIGN.md",
		"theme:build": "node obsidian/theme/build.ts build/theme.css",
		"obsidian": "node obsidian/testbed/obsidian.ts launch --foreground",
		"obsidian:doctor": "node obsidian/testbed/obsidian.ts doctor",
		"obsidian:shot": "node obsidian/testbed/obsidian.ts shot",
		"obsidian:compare": "node obsidian/testbed/obsidian.ts compare",
		"obsidian:layers": "node obsidian/testbed/obsidian.ts layers",
		"obsidian:sync": "node obsidian/testbed/obsidian.ts sync",
		"obsidian:stop": "node obsidian/testbed/obsidian.ts stop --run main",
		"obsidian:check": "tsc -p obsidian/testbed"
	},
	"devDependencies": {
		"@google/design.md": "0.4.0",
		"@types/node": "24.19.4",
		"playwright-core": "1.64.1",
		"typescript": "7.0.2"
	}
}
